# ---------------------------------------------------------------------------
# AI Act Copilot, frontend environment
#
# Copy to .env.local (gitignored) and fill in. EVERY value here is SERVER-SIDE
# ONLY. None is prefixed NEXT_PUBLIC_, which is what keeps them out of the
# browser bundle: Next.js inlines ONLY NEXT_PUBLIC_* variables into client
# code. Never add that prefix to anything below.
# ---------------------------------------------------------------------------

# Auth.js session signing/encryption key.
# Generate with:  npx auth secret     (or: openssl rand -base64 32)
AUTH_SECRET=

# Public origin of THIS app. Required in production; optional locally.
# AUTH_URL=http://localhost:3000

# --- Google OAuth (primary sign-in) ---------------------------------------
# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID
# Authorised redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# --- FastAPI backend ------------------------------------------------------
# Where the Python backend is reachable from the Next.js SERVER (not browser).
FASTAPI_URL=http://127.0.0.1:8000

# Shared HMAC key used to sign the 60-second service token the BFF sends to
# FastAPI. MUST be byte-identical to INTERNAL_API_SECRET in backend/.env.
# Generate with: openssl rand -base64 32
INTERNAL_API_SECRET=

# --- Magic-link sign-in (OPTIONAL) ----------------------------------------
# Auth.js requires a database adapter for email sign-in, because verification
# tokens must be persisted and single-use. Leave BOTH blank to run with Google
# only. The sign-in page adapts automatically.
# See the README section "Magic-link sign-in" before enabling: it adds tables,
# and there is an Alembic caveat.
AUTH_RESEND_KEY=
AUTH_DB_URL=
AUTH_EMAIL_FROM=
