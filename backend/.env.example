OPENAI_API_KEY=sk-xxxxxxxx
# Required. Shared HMAC key for the BFF service token; the same value in the
# Next.js server env. /ask and /classify refuse every call without it.
INTERNAL_API_SECRET=replace-with-openssl-rand-base64-32
# Optional. 1 runs /ask through the LangGraph agentic pipeline (ADR-20);
# default off in the repo. Set per environment.
AGENTIC_RAG=0
# production | dev | test. Defaults to dev when unset; Railway sets production.
APP_ENV=dev
# Comma-separated e-mails allowed to open the admin trace viewer (/admin/*).
# Empty or unset = nobody. Operator accounts only: traces contain user questions.
ADMIN_EMAILS=
# Live DB is Supabase (Session pooler); docker-compose.yml is for local/CI tests only.
DATABASE_URL=postgresql://aiact:aiact@localhost:5432/aiact
